{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix landing",
  "buildCommand": "npm run build --prefix landing",
  "outputDirectory": "landing/dist",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "ko"
        }
      ],
      "destination": "/locales/ko/index.html"
    },
    {
      "source": "/privacy.html",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "ko"
        }
      ],
      "destination": "/locales/ko/privacy.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "en"
        }
      ],
      "destination": "/locales/en/index.html"
    },
    {
      "source": "/privacy.html",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "en"
        }
      ],
      "destination": "/locales/en/privacy.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "ja"
        }
      ],
      "destination": "/locales/ja/index.html"
    },
    {
      "source": "/privacy.html",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "ja"
        }
      ],
      "destination": "/locales/ja/privacy.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "pt"
        }
      ],
      "destination": "/locales/pt/index.html"
    },
    {
      "source": "/privacy.html",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "pt"
        }
      ],
      "destination": "/locales/pt/privacy.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "es"
        }
      ],
      "destination": "/locales/es/index.html"
    },
    {
      "source": "/privacy.html",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "es"
        }
      ],
      "destination": "/locales/es/privacy.html"
    },
    {
      "source": "/",
      "destination": "/locales/ko/index.html"
    },
    {
      "source": "/privacy.html",
      "destination": "/locales/ko/privacy.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ]
}
